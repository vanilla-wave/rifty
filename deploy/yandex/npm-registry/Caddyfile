{
	admin off
}

registry.rifty.dev, registry-origin.rifty.dev {
	header {
		>Access-Control-Allow-Origin "*"
		>Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		>Access-Control-Allow-Headers "accept, content-type"
		>Cross-Origin-Resource-Policy "cross-origin"
	}

	@packuments path_regexp packument_cache ^/npm-registry/(?:@[^/]+/[^/]+|[^/]+)$
	header @packuments >Cache-Control "public, max-age=300, stale-while-revalidate=86400"
	header @packuments >Vary "Accept"

	@tarballs path_regexp tarball_cache ^/npm-registry/.*/-/.*\.tgz$
	header @tarballs >Cache-Control "public, max-age=31536000, immutable"

	@options method OPTIONS
	respond @options "" 204

	@unsupported not method GET HEAD OPTIONS
	header @unsupported Allow "GET, HEAD, OPTIONS"
	respond @unsupported "Method Not Allowed" 405

	handle /npm-registry {
		rewrite * /
		reverse_proxy https://registry.npmjs.org {
			header_up Host registry.npmjs.org
		}
	}

	handle_path /npm-registry/* {
		reverse_proxy https://registry.npmjs.org {
			header_up Host registry.npmjs.org
		}
	}

	respond "Not Found" 404
}
