{
  "name": "@riftydev/runtime-js",
  "version": "0.1.0",
  "description": "Node-compatible JS runtime for rifty: CJS/ESM module loader and node: builtins, in a Worker.",
  "type": "module",
  "license": "MIT",
  "author": "vanilla-wave <vizetmail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanilla-wave/rifty.git",
    "directory": "packages/runtime-js"
  },
  "homepage": "https://github.com/vanilla-wave/rifty#readme",
  "bugs": {
    "url": "https://github.com/vanilla-wave/rifty/issues"
  },
  "keywords": ["rifty", "browser", "webcontainer", "runtime", "node-compatible", "module-loader"],
  "sideEffects": ["./dist/index.js", "./dist/worker.js"],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal/index.ts",
    "./worker": "./src/worker-entry.ts",
    "./install-process": "./src/ipc/install-process.ts",
    "./ipc/exec-sync-handler": "./src/ipc/exec-sync-handler.ts",
    "./loader": "./src/module-loader/index.ts",
    "./env/capabilities": "./src/env/capabilities.ts",
    "./builtins": "./src/builtins/public.ts",
    "./builtins/fs-watch": "./src/builtins/fs-watch.ts",
    "./builtins/process": "./src/builtins/process.ts",
    "./builtins/timers": "./src/builtins/timers.ts",
    "./builtins/buffer": "./src/builtins/buffer.ts",
    "./builtins/console": "./src/builtins/console.ts",
    "./builtins/module": "./src/builtins/module.ts",
    "./builtins/child_process": "./src/builtins/child_process.ts",
    "./builtins/node-entry": "./src/builtins/node-entry.ts",
    "./builtins/node-entry-url": "./src/builtins/node-entry-url.ts",
    "./builtins/process-identity": "./src/builtins/process-identity.ts",
    "./builtins/os": "./src/builtins/os.ts",
    "./builtins/path": "./src/builtins/path.ts",
    "./builtins/perf_hooks": "./src/builtins/perf_hooks.ts",
    "./builtins/fs": "./src/builtins/fs.ts"
  },
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "import": "./dist/worker.js"
      },
      "./install-process": {
        "types": "./dist/install-process.d.ts",
        "import": "./dist/install-process.js"
      },
      "./ipc/exec-sync-handler": {
        "types": "./dist/ipc/exec-sync-handler.d.ts",
        "import": "./dist/ipc/exec-sync-handler.js"
      },
      "./loader": {
        "types": "./dist/loader.d.ts",
        "import": "./dist/loader.js"
      },
      "./env/capabilities": {
        "types": "./dist/env/capabilities.d.ts",
        "import": "./dist/env/capabilities.js"
      },
      "./builtins": {
        "types": "./dist/builtins.d.ts",
        "import": "./dist/builtins.js"
      },
      "./builtins/fs-watch": {
        "types": "./dist/builtins/fs-watch.d.ts",
        "import": "./dist/builtins/fs-watch.js"
      },
      "./builtins/process": {
        "types": "./dist/builtins/process.d.ts",
        "import": "./dist/builtins/process.js"
      },
      "./builtins/timers": {
        "types": "./dist/builtins/timers.d.ts",
        "import": "./dist/builtins/timers.js"
      },
      "./builtins/buffer": {
        "types": "./dist/builtins/buffer.d.ts",
        "import": "./dist/builtins/buffer.js"
      },
      "./builtins/console": {
        "types": "./dist/builtins/console.d.ts",
        "import": "./dist/builtins/console.js"
      },
      "./builtins/module": {
        "types": "./dist/builtins/module.d.ts",
        "import": "./dist/builtins/module.js"
      },
      "./builtins/child_process": {
        "types": "./dist/builtins/child_process.d.ts",
        "import": "./dist/builtins/child_process.js"
      },
      "./builtins/node-entry": {
        "types": "./dist/builtins/node-entry.d.ts",
        "import": "./dist/builtins/node-entry.js"
      },
      "./builtins/node-entry-url": {
        "types": "./dist/builtins/node-entry-url.d.ts",
        "import": "./dist/builtins/node-entry-url.js"
      },
      "./builtins/process-identity": {
        "types": "./dist/builtins/process-identity.d.ts",
        "import": "./dist/builtins/process-identity.js"
      },
      "./builtins/os": {
        "types": "./dist/builtins/os.d.ts",
        "import": "./dist/builtins/os.js"
      },
      "./builtins/path": {
        "types": "./dist/builtins/path.d.ts",
        "import": "./dist/builtins/path.js"
      },
      "./builtins/perf_hooks": {
        "types": "./dist/builtins/perf_hooks.d.ts",
        "import": "./dist/builtins/perf_hooks.js"
      },
      "./builtins/fs": {
        "types": "./dist/builtins/fs.d.ts",
        "import": "./dist/builtins/fs.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@riftydev/io": "workspace:*",
    "@riftydev/kernel": "workspace:*",
    "@riftydev/runtime-wasi": "workspace:*",
    "@riftydev/vfs": "workspace:*",
    "acorn": "^8.14.0",
    "cjs-module-lexer": "2.2.0",
    "quickjs-emscripten-core": "^0.32.0",
    "typescript": "5.9.3"
  }
}
