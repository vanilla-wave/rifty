{
  "name": "@riftydev/isolate-host",
  "version": "0.1.0",
  "description": "Run guest JS like `node -e` in a fresh rifty runtime inside a V8 isolate (isolated-vm) in a disposable child process.",
  "type": "module",
  "license": "MIT",
  "author": "vanilla-wave <vizetmail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanilla-wave/rifty.git",
    "directory": "packages/isolate-host"
  },
  "homepage": "https://github.com/vanilla-wave/rifty#readme",
  "bugs": {
    "url": "https://github.com/vanilla-wave/rifty/issues"
  },
  "keywords": [
    "rifty",
    "browser",
    "webcontainer",
    "isolate",
    "isolated-vm",
    "sandbox",
    "node-compatible"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup && node scripts/build-runtime.mjs"
  },
  "dependencies": {
    "isolated-vm": "7.0.2"
  },
  "devDependencies": {
    "@riftydev/io": "workspace:*",
    "@riftydev/runtime-js": "workspace:*",
    "@riftydev/vfs": "workspace:*",
    "esbuild": "0.28.0"
  }
}
