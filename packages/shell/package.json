{
  "name": "@riftydev/shell",
  "version": "0.1.0",
  "description": "Tiny bash-flavoured shell for rifty, backed by @riftydev/vfs.",
  "type": "module",
  "license": "MIT",
  "author": "vanilla-wave <vizetmail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanilla-wave/rifty.git",
    "directory": "packages/shell"
  },
  "homepage": "https://github.com/vanilla-wave/rifty#readme",
  "bugs": {
    "url": "https://github.com/vanilla-wave/rifty/issues"
  },
  "keywords": ["rifty", "browser", "webcontainer", "shell", "bash"],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:run": "vitest run tests/",
    "build": "tsup"
  },
  "dependencies": {
    "@riftydev/io": "workspace:*",
    "@riftydev/vfs": "workspace:*",
    "@riftydev/git": "workspace:*"
  },
  "devDependencies": {
    "@riftydev/net": "workspace:*"
  }
}
