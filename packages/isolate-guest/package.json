{
  "name": "@riftydev/isolate-guest",
  "version": "0.1.0",
  "description": "rifty's V8-isolate guest: the node -e runtime bundle and its bridge contract, for custom isolate embedders (unstable).",
  "type": "module",
  "license": "MIT",
  "author": "vanilla-wave <vizetmail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanilla-wave/rifty.git",
    "directory": "packages/isolate-guest"
  },
  "homepage": "https://github.com/vanilla-wave/rifty#readme",
  "bugs": {
    "url": "https://github.com/vanilla-wave/rifty/issues"
  },
  "keywords": [
    "rifty",
    "browser",
    "webcontainer",
    "isolate",
    "isolated-vm",
    "sandbox",
    "node-compatible"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./guest.js": "./dist/guest.js"
  },
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./guest.js": "./dist/guest.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup && node scripts/build-guest.mjs"
  },
  "devDependencies": {
    "@riftydev/io": "workspace:*",
    "@riftydev/runtime-js": "workspace:*",
    "@riftydev/vfs": "workspace:*",
    "esbuild": "0.28.0"
  },
  "engines": {
    "node": ">=24"
  }
}
