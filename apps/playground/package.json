    "@riftydev/git": "workspace:*",
    "@riftydev/io": "workspace:*",
    "@riftydev/kernel": "workspace:*",
    "@riftydev/net": "workspace:*",
    "@riftydev/npm-client": "workspace:*",
    "@riftydev/runtime-js": "workspace:*",
    "@riftydev/service-worker": "workspace:*",
    "@riftydev/shell": "workspace:*",
    "@riftydev/terminal": "workspace:*",
    "@riftydev/ts-language-service": "workspace:*",
    "@riftydev/vfs": "workspace:*",
    "@riftydev/workbench": "workspace:*",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.0",
    "solid-js": "^1.9.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
