{
  "name": "@riftydev/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:no-coi": "vite optimize --config vite.no-coi.config.ts --force && vite --config vite.no-coi.config.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
