{
  "name": "@riftydev/shadow-registry",
  "version": "0.1.0",
  "description": "Data tables of in-browser npm package substitutions for rifty.",
  "type": "module",
  "license": "MIT",
  "author": "vanilla-wave <vizetmail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanilla-wave/rifty.git",
    "directory": "tools/shadow-registry"
  },
  "homepage": "https://github.com/vanilla-wave/rifty#readme",
  "bugs": {
    "url": "https://github.com/vanilla-wave/rifty/issues"
  },
  "keywords": ["rifty", "browser", "webcontainer", "npm-overrides"],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./esbuild-binding": "./src/esbuild-binding.ts",
    "./esbuild-transform": "./src/esbuild-transform.ts"
  },
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./esbuild-transform": {
        "types": "./dist/esbuild-transform.d.ts",
        "import": "./dist/esbuild-transform.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup"
  },
  "devDependencies": {
    "@riftydev/vfs": "workspace:*",
    "esbuild": "0.28.0",
    "esbuild-wasm": "0.28.0"
  }
}
