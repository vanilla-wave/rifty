{
  "src/App.vue": "<script setup>\nimport { computed, reactive, ref } from 'vue';\nconst key = 'booking-workflow-v1';\nconst state = ref(JSON.parse(localStorage.getItem(key) || '{\"rooms\":[],\"bookings\":[]}'));\nconst roomForm = reactive({ id: '', name: '', capacity: '' });\nconst booking = reactive({ id: '', room: '', date: '', start: '', end: '', seats: '' });\nconst roomFilter = ref('');\nconst dateFilter = ref('');\nconst message = ref('');\nconst integer = value => /^\\d+$/.test(String(value)) && Number.isSafeInteger(Number(value)) && Number(value) > 0;\nfunction commit(next) { localStorage.setItem(key, JSON.stringify(next)); state.value = next; message.value = ''; }\nfunction reject(text) { message.value = text; }\nfunction saveRoom() {\n const name = roomForm.name.trim();\n const capacity = Number(roomForm.capacity);\n if (!name || !integer(roomForm.capacity) || state.value.rooms.some(r => r.id !== roomForm.id && r.name.toLowerCase() === name.toLowerCase())) return reject('Room name must be unique; capacity must be a positive integer.');\n if (state.value.bookings.some(b => b.room === roomForm.id && b.seats > capacity)) return reject('Capacity reduction would invalidate a reservation.');\n const row = { id: roomForm.id || crypto.randomUUID(), name, capacity };\n commit({ ...state.value, rooms: roomForm.id ? state.value.rooms.map(r => r.id === roomForm.id ? row : r) : [...state.value.rooms, row] });\n Object.assign(roomForm, { id: '', name: '', capacity: '' });\n}\nfunction editRoom(row) { Object.assign(roomForm, row); }\nfunction deleteRoom(id) {\n if (state.value.bookings.some(b => b.room === id)) return reject('Room has reservations.');\n commit({ ...state.value, rooms: state.value.rooms.filter(r => r.id !== id) });\n}\nfunction validDate(text) {\n if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(text)) return false;\n const date = new Date(`${text}T12:00:00Z`);\n return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === text;\n}\nfunction saveBooking() {\n const selected = state.value.rooms.find(r => r.id === booking.room);\n const time = value => /^(?:[01]\\d|2[0-3]):[0-5]\\d$/.test(value);\n const row = { ...booking, id: booking.id || crypto.randomUUID(), seats: Number(booking.seats) };\n if (!selected || !validDate(row.date) || !time(row.start) || !time(row.end) || row.start >= row.end || !integer(booking.seats) || row.seats > selected.capacity) return reject('Valid room/date/time interval and seats within capacity required.');\n if (state.value.bookings.some(b => b.id !== row.id && b.room === row.room && b.date === row.date && row.start < b.end && b.start < row.end)) return reject('Room is already reserved for this interval.');\n commit({ ...state.value, bookings: booking.id ? state.value.bookings.map(b => b.id === row.id ? row : b) : [...state.value.bookings, row] });\n newBooking();\n}\nfunction newBooking() { Object.assign(booking, { id: '', room: '', date: '', start: '', end: '', seats: '' }); }\nfunction editBooking(row) { Object.assign(booking, row); }\nfunction deleteBooking(id) { commit({ ...state.value, bookings: state.value.bookings.filter(b => b.id !== id) }); }\nconst roomName = id => state.value.rooms.find(r => r.id === id)?.name || '';\nconst displayed = computed(() => state.value.bookings.filter(b => roomName(b.room).toLowerCase().includes(roomFilter.value.toLowerCase()) && b.date.includes(dateFilter.value)).sort((a,b) => a.date.localeCompare(b.date) || a.start.localeCompare(b.start)));\n</script>\n<template>\n<main><h1>Room reservations</h1><p role=\"status\" aria-label=\"Validation\">{{ message }}</p>\n<section aria-label=\"Rooms\"><h2>Rooms</h2>\n<label>Room name <input v-model=\"roomForm.name\"></label><label>Capacity <input v-model=\"roomForm.capacity\" inputmode=\"numeric\"></label><a href=\"#\" @click.prevent=\"saveRoom\">Save room</a>\n<ul><li v-for=\"row in state.rooms\" :key=\"row.id\">{{row.name}} \u2014 capacity {{row.capacity}} <a href=\"#\" @click.prevent=\"editRoom(row)\">Edit room {{row.name}}</a> <a href=\"#\" @click.prevent=\"deleteRoom(row.id)\">Delete room {{row.name}}</a></li></ul></section>\n<section aria-label=\"Reservation editor\"><h2>Reservation</h2><a href=\"#\" @click.prevent=\"newBooking\">New reservation</a>\n<label>Reservation room <select v-model=\"booking.room\"><option value=\"\">Choose room</option><option v-for=\"r in state.rooms\" :key=\"r.id\" :value=\"r.id\">{{r.name}}</option></select></label>\n<label>Date <input v-model=\"booking.date\" placeholder=\"YYYY-MM-DD\"></label><label>Start <input v-model=\"booking.start\" placeholder=\"HH:MM\"></label><label>End <input v-model=\"booking.end\" placeholder=\"HH:MM\"></label><label>Seats <input v-model=\"booking.seats\" inputmode=\"numeric\"></label><a href=\"#\" @click.prevent=\"saveBooking\">Save reservation</a></section>\n<section aria-label=\"Reservation list\"><h2>Reservations</h2><label>Room filter <input v-model=\"roomFilter\"></label><label>Date filter <input v-model=\"dateFilter\"></label>\n<article v-for=\"b in displayed\" :key=\"b.id\"><p>{{roomName(b.room)}} {{b.date}} {{b.start}}\u2013{{b.end}}; {{b.seats}} seats</p><a href=\"#\" @click.prevent=\"editBooking(b)\">Edit reservation {{roomName(b.room)}} {{b.date}} {{b.start}}</a><a href=\"#\" @click.prevent=\"deleteBooking(b.id)\">Delete reservation {{roomName(b.room)}} {{b.date}} {{b.start}}</a></article></section>\n</main>\n</template>\n<style>body{font-family:system-ui;margin:20px}label{display:block;margin:8px 0}input,select,button{font:inherit;padding:5px}button{margin:4px}article{border-top:1px solid #bbb;padding:8px}</style>\n"
}
