{
  "src/App.svelte": "<script>\nconst key = 'expense-settlement-v1';\nlet state = JSON.parse(localStorage.getItem(key) || '{\"people\":[],\"expenses\":[]}');\nlet personName = '';\nlet description = '';\nlet payer = '';\nlet amount = '';\nlet participants = [];\nlet editId = '';\nlet message = '';\nfunction money(value) {\n const cents = BigInt(value);\n const absolute = cents < 0n ? -cents : cents;\n return `${cents < 0n ? '-' : ''}${absolute / 100n}.${String(absolute % 100n).padStart(2, '0')}`;\n}\nconst identity = id => state.people.find(p => p.id === id)?.name || '';\nfunction commit(next) { localStorage.setItem(key, JSON.stringify(next)); state = next; message = ''; }\nfunction reject(text) { message = text; }\nfunction addPerson() {\n const name = personName.trim();\n if (!name || state.people.some(p => p.name.toLowerCase() === name.toLowerCase())) return reject('Person name must be nonempty and unique.');\n commit({ ...state, people: [...state.people, { id: crypto.randomUUID(), name }] }); personName = '';\n}\nfunction deletePerson(id) {\n if (state.expenses.some(e => e.payer === id || e.participants.includes(id))) return reject('Person is referenced by an expense.');\n commit({ ...state, people: state.people.filter(p => p.id !== id) });\n participants = participants.filter(p => p !== id); if (payer === id) payer = '';\n}\nfunction parseCents(value) {\n if (!/^\\d+(?:\\.\\d{1,2})?$/.test(value)) return null;\n const [whole, fraction = ''] = value.split('.');\n const result = Number(whole) * 100 + Number(fraction.padEnd(2, '0'));\n return Number.isSafeInteger(result) && result > 0 ? result : null;\n}\nfunction saveExpense() {\n const cents = parseCents(amount);\n const selected = state.people.filter(p => participants.includes(p.id)).map(p => p.id);\n if (!description.trim() || cents === null || !state.people.some(p => p.id === payer) || !selected.length) return reject('Description, payer, valid positive cent amount and participants required.');\n const row = { id: editId || crypto.randomUUID(), description: description.trim(), payer, cents, participants: selected };\n commit({ ...state, expenses: editId ? state.expenses.map(e => e.id === editId ? row : e) : [...state.expenses, row] }); newExpense();\n}\nfunction newExpense() { editId = ''; description = ''; payer = ''; amount = ''; participants = []; }\nfunction editExpense(row) { editId = row.id; description = row.description; payer = row.payer; amount = money(row.cents); participants = [...row.participants]; }\nfunction deleteExpense(id) { commit({ ...state, expenses: state.expenses.filter(e => e.id !== id) }); }\nfunction calculate(current) {\n const rows = current.people.map(p => ({ ...p, paid: 0n, owed: 0n, net: 0n }));\n for (const expense of current.expenses) {\n  rows.find(p => p.id === expense.payer).paid += BigInt(expense.cents);\n  const selected = rows.filter(p => expense.participants.includes(p.id));\n  selected.forEach((p, index) => { p.owed += BigInt(expense.cents) / BigInt(selected.length) + (BigInt(index) < BigInt(expense.cents) % BigInt(selected.length) ? 1n : 0n); });\n }\n rows.forEach(p => { p.net = p.paid - p.owed; }); return rows;\n}\nfunction settle(rows) {\n const creditors = rows.filter(p => p.net > 0).map(p => ({ ...p, left: p.net }));\n const result = [];\n for (const debtor of rows.filter(p => p.net < 0)) {\n  let left = -debtor.net;\n  for (const creditor of creditors) {\n   const cents = left < creditor.left ? left : creditor.left;\n   if (cents > 0) { result.push({ from: debtor.name, to: creditor.name, cents }); left -= cents; creditor.left -= cents; }\n  }\n }\n return result;\n}\n$: totals = calculate(state);\n$: transfers = settle(totals);\n</script>\n<main><h1>Shared expenses</h1><p role=\"status\">{message}</p>\n<section aria-label=\"People\"><h2>People</h2><label>Person name <input bind:value={personName}></label><button onclick={addPerson}>Add person</button>\n<ul>{#each state.people as person (person.id)}<li>{person.name} <button onclick={() => deletePerson(person.id)}>Delete person {person.name}</button></li>{/each}</ul></section>\n<section aria-label=\"Expense editor\"><h2>Expense</h2><button onclick={newExpense}>New expense</button>\n<label>Expense description <input bind:value={description}></label><label>Payer <select bind:value={payer}><option value=\"\">Choose payer</option>{#each state.people as person}<option value={person.id}>{person.name}</option>{/each}</select></label>\n<label>Amount <input bind:value={amount} inputmode=\"decimal\"></label><fieldset><legend>Participants</legend>{#each state.people as person}<label><input type=\"checkbox\" bind:group={participants} value={person.id}>{person.name}</label>{/each}</fieldset><button onclick={saveExpense}>Save expense</button></section>\n<section aria-label=\"Expenses\"><h2>Expenses</h2>{#each state.expenses as row (row.id)}<article><p>{row.description}: {identity(row.payer)} paid {money(row.cents)}; participants {row.participants.map(identity).join(', ')}</p><button onclick={() => editExpense(row)}>Edit expense {row.description}</button><button onclick={() => deleteExpense(row.id)}>Delete expense {row.description}</button></article>{/each}</section>\n<section aria-label=\"Balances\"><h2>Balances</h2><table><thead><tr><th>Person</th><th>Paid</th><th>Owed</th><th>Net</th></tr></thead><tbody>{#each totals as row}<tr><td>{row.name}</td><td>{money(row.paid)}</td><td>{money(row.owed)}</td><td>{money(row.net)}</td></tr>{/each}</tbody></table></section>\n<section aria-label=\"Settlement\"><h2>Settlement</h2>{#each transfers as row}<article><span aria-label=\"Payer\">{row.from}</span> \u2192 <span aria-label=\"Receiver\">{row.to}</span>: <span aria-label=\"Amount\">{money(row.cents)}</span></article>{/each}</section>\n</main>\n<style>body{font-family:system-ui;margin:20px}label{display:block;margin:8px 0}input,select,button{font:inherit;padding:5px}button{margin:4px}td,th{padding:8px}article{border-top:1px solid #bbb;padding:8px}</style>\n"
}
