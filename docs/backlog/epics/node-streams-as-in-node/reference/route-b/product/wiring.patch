@@ -0,0 +1,27 @@
+/** PROBE (route B): fs streams are Node v24.16.0's lib/internal/fs/streams.js (io `nodeFsStreams`). */
+import { nodeFsStreams } from '@riftydev/io';
+
+type Ctor = new (path: unknown, options?: unknown) => unknown;
+const cls = (name: 'ReadStream' | 'WriteStream') => nodeFsStreams()[name] as Ctor;
+// lib/fs.js: `createReadStream(path, options) { lazyLoadStreams(); return new ReadStream(path, options); }`
+export function createReadStream(path: unknown, options?: unknown): unknown {
+  return new (cls('ReadStream'))(path, options);
+}
+export function createWriteStream(path: unknown, options?: unknown): unknown {
+  return new (cls('WriteStream'))(path, options);
+}
+/** lib/fs.js's lazy `ReadStream`/`WriteStream` accessors. */
+export function defineStreamClasses<T extends object>(fs: T): T {
+  for (const name of ['ReadStream', 'WriteStream'] as const) {
+    let value: Ctor | undefined;
+    Object.defineProperty(fs, name, {
+      get: () => value ?? cls(name),
+      set: (v: Ctor) => {
+        value = v;
+      },
+      enumerable: true,
+      configurable: true,
+    });
+  }
+  return fs;
+}
