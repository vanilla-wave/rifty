+/**
+ * PROBE (route B product shape): Node v24.16.0's stream core + fs streams, generated
+ * (`generated/node-streams.js`) over `bindings.ts`. Built on first read; every export is a pure call.
+ */
+import { Buffer } from '../../buffer.ts';
+import { loadBuiltin, readBuiltinUncached } from '../../builtin-registry.ts';
+import { NotImplementedError } from '../../errors.ts';
+import { EventEmitter } from '../../event-emitter.ts';
+import { createRouteB } from './bindings.ts';
+import createNodeStreams from './generated/node-streams.js';
+
+type Mod = Record<string, unknown>;
+type Proc = {
+  nextTick?: (cb: (...a: unknown[]) => void, ...a: unknown[]) => void;
+  emitWarning: (...a: unknown[]) => void;
+} & Mod;
+
+function builtin(id: string): Mod {
+  const m = loadBuiltin(id);
+  if (m === null) throw new Error(`route B: node:${id} is not registered`);
+  return m;
+}
+const active = (): Proc | null => readBuiltinUncached('process') as Proc | null;
+/** The active process at call time (ADR-0458); io used without runtime-js defers as io does today. */
+const processFacade = {
+  nextTick(cb: (...a: unknown[]) => void, ...args: unknown[]): void {
+    const p = active();
+    if (typeof p?.nextTick === 'function') p.nextTick(cb, ...args);
+    else queueMicrotask(() => cb(...args));
+  },
+  emitWarning(...args: unknown[]): void {
+    const p = active() as Proc;
+    p.emitWarning(...args);
+  },
+  get platform(): unknown {
+    return active()?.platform;
+  },
+  get noDeprecation(): unknown {
+    return active()?.noDeprecation;
+  },
+  get stdout(): unknown {
+    return active()?.stdout;
+  },
+  get stderr(): unknown {
+    return active()?.stderr;
+  },
+};
+/** `string_decoder` is runtime-js's: resolved per construction (the stream core loads before it registers). */
+function StringDecoder(encoding?: unknown): object {
+  const SD = builtin('string_decoder').StringDecoder as new (e?: unknown) => object;
+  return new SD(encoding);
+}
+
+let load: ((id: string) => unknown) | undefined;
+function nodeModule(id: string): Mod {
+  load ??= createRouteB(createNodeStreams, {
+    module: (m) =>
+      m === 'buffer'
+        ? { Buffer }
+        : m === 'events'
+          ? EventEmitter
+          : m === 'string_decoder'
+            ? { StringDecoder }
+            : (loadBuiltin(m) ?? undefined),
+    process: processFacade,
+    NotImplementedError,
+  });
+  return load(id) as Mod;
+}
+export function nodeStream(): Mod {
+  return nodeModule('stream');
+}
+export function nodeStreamPromises(): Mod {
+  return nodeModule('stream/promises');
+}
+export function nodeFsStreams(): Mod {
+  return nodeModule('internal/fs/streams');
+}
+export function pick(name: string): never {
+  return nodeStream()[name] as never;
+}
